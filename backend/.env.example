# Copy this to .env for local development only.
# Do not commit backend/.env. In Render/Railway, set these as Environment Variables.

# MongoDB Connection (MongoDB Atlas or local)
# Atlas format:
# MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@cluster0.xxxxx.mongodb.net/cat_prep_db?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb://localhost:27017/cat_prep_db

# JWT Secret - use a long random string
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32chars

# Server Port
PORT=5000

# Frontend URL (for CORS) - change to your deployed frontend URL
FRONTEND_URL=http://localhost:5000

# Node Environment
NODE_ENV=development

# Optional: enables the real AI coach. Without this, the local planner assistant still works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
