# Copy this to .env and fill in your values
# MongoDB Connection (MongoDB Atlas or local)
# For local development, use the default local URI below.
# For Atlas, replace with your own connection string.
MONGODB_URI=mongodb://localhost:27017/cat_prep_db

# JWT Secret - use a long random string
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32chars

# Server Port
PORT=5000

# Frontend URL (for CORS) - change to your deployed frontend URL
FRONTEND_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
